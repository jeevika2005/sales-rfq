// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manager
  sales
  viewer
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  fullName     String
  role         UserRole
  active       Boolean  @default(true)
  trashed      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers     Customer[]
  createdQuotes Quote[]        @relation("QuoteCreatedBy")
  updatedQuotes Quote[]        @relation("QuoteUpdatedBy")
  quoteVersions QuoteVersion[] @relation("QuoteVersionCreatedBy")
  attachments   Attachment[]   @relation("AttachmentCreatedBy")
  auditLogs     AuditLog[]
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String?
  phone       String?
  companyCode String?
  notes       String?
  archived    Boolean  @default(false)
  createdBy   String?  @db.Uuid
  creator     User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes Quote[]

  @@index([name])
}

model Quote {
  id          String @id @default(uuid()) @db.Uuid
  quoteNumber String @unique

  customerId    String?   @db.Uuid
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String?
  customerPhone String?

  status       String  @default("draft")
  currency     String  @default("USD")
  totalAmount  Float   @default(0)
  deliveryDate String?
  notes        String?
  attributes   Json

  currentVersion Int @default(1)

  createdBy String? @db.Uuid
  creator   User?   @relation("QuoteCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updatedBy String? @db.Uuid
  updater   User?   @relation("QuoteUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       QuoteItem[]
  versions    QuoteVersion[]
  attachments Attachment[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([createdBy])
}

model QuoteItem {
  id      String @id @default(uuid()) @db.Uuid
  quoteId String @db.Uuid
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  itemName      String
  componentType String?
  material      String?
  specification String?
  manufacturer  String?
  partNumber    String?
  quantity      Float   @default(1)
  unitPrice     Float   @default(0)
  totalPrice    Float
  leadTimeDays  Int     @default(0)
  notes         String?
  attributes    Json
}

model QuoteVersion {
  id                 String  @id @default(uuid()) @db.Uuid
  quoteId            String  @db.Uuid
  quote              Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  version            Int
  snapshotJson       Json
  changesSummaryJson Json?
  changeNotes        String?

  createdBy String?  @db.Uuid
  creator   User?    @relation("QuoteVersionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([quoteId, version])
}

enum AttachmentKind {
  rfq_source
  spec_doc
  export
}

model Attachment {
  id         String         @id @default(uuid()) @db.Uuid
  quoteId    String?        @db.Uuid
  quote      Quote?         @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  kind       AttachmentKind
  fileName   String
  mimeType   String
  byteSize   Int
  storageKey String

  createdBy String?  @db.Uuid
  creator   User?    @relation("AttachmentCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

enum DataScope {
  CREATED
  ASSIGNED
  ALL
}

model Role {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  dataScope DataScope
  active    Boolean   @default(true)
  trashed   Boolean   @default(false)
  createdBy String    @db.Uuid
  updatedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rolePermissions RolePermission[]

  @@index([name])
}

model RolePermission {
  id          String   @id @default(uuid()) @db.Uuid
  roleId      String   @db.Uuid
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  menuKey     String
  permissions Json
  active      Boolean  @default(true)
  trashed     Boolean  @default(false)
  createdBy   String   @db.Uuid
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([roleId, menuKey])
}

model LeftMenu {
  id       String  @id @default(uuid()) @db.Uuid
  menuKey  String  @unique
  name     String
  icon     String?
  url      String?
  isParent Boolean @default(false)

  parentId String?    @db.Uuid
  parent   LeftMenu?  @relation("LeftMenuParent", fields: [parentId], references: [id], onDelete: SetNull)
  children LeftMenu[] @relation("LeftMenuParent")

  active    Boolean  @default(true)
  trashed   Boolean  @default(false)
  createdBy String   @db.Uuid
  updatedBy String?  @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
