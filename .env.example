# Copy this file to .env and fill in real values locally.
# Never commit the real .env file (it's gitignored).

# --- Database ---
# PostgreSQL connection string, e.g. postgresql://user:password@localhost:5432/mes_sales_rfq
DATABASE_URL=

# --- Auth (NextAuth v5) ---
# Random secret used to sign session JWTs — generate with: openssl rand -base64 32
AUTH_SECRET=
# Base URL of the app (used by NextAuth for callbacks)
AUTH_URL=http://localhost:3000
# Seeded on first boot only — creates one admin user if none exists yet
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Gemini AI (RFQ parsing) ---
# API key for Google Gemini (@google/genai) — server-only, never expose to the client
GEMINI_API_KEY=
# Model used for RFQ parsing
GEMINI_SALES_MODEL=gemini-2.5-flash
# Max tokens Gemini may return for one parse call
GEMINI_SALES_MAX_OUTPUT_TOKENS=32768
# Max size (bytes) of a PDF sent to Gemini for multimodal parsing
GEMINI_SALES_PDF_DOCUMENT_MAX_BYTES=10000000
# Request timeout (ms) for Gemini calls
GEMINI_TIMEOUT_MS=600000

# --- Excel RFQ parsing guards ---
# Deterministic Excel parser refuses sheets larger than these limits
SALES_RFQ_PARSE_MAX_ROWS=320
SALES_RFQ_PARSE_MAX_COLS=50
SALES_RFQ_PARSE_MAX_CELL=500

# --- Object storage (S3-compatible: AWS S3 or Hetzner) ---
# Used to store uploaded RFQ files, spec docs, and Excel exports
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
